{
  "name": "football-career",
  "version": "0.1.0",
  "private": true,
  "description": "Football career game (youngster to retirement) built on a TypeScript/Three.js port of GameplayFootball",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/build-manifest.mjs && python3 scripts/convert-database.py"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
